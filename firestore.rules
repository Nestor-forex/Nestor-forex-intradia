rules_version = '2';

// Reglas de seguridad de Firestore compartidas por Nestor Forex y su app
// hermana Nestor Forex Intradía (nestor-forex-intradia) — mismo proyecto de
// Firebase, mismas cuentas de usuarios/administrador, pero cada app guarda
// su diario de operaciones en su propia colección para no mezclar
// estadísticas de swing con las de intradía.
//
// Cómo funciona el acceso:
// - Cada persona solo puede leer y crear SU PROPIO documento en `users`.
// - Solo el administrador (identificado por su correo, más abajo) puede
//   leer la lista completa de usuarios, aprobar o retirar a alguien.
// - Nadie puede aprobarse a sí mismo: al crear su solicitud, el estado
//   queda forzado a 'pendiente', y un usuario normal no puede cambiar su
//   propio campo `estado`.
// - Las operaciones del diario de swing (`trades`, esta app) y las de
//   intradía (`trades_intradia`, la app hermana) de cada usuario solo son
//   visibles para ese mismo usuario, y solo si su cuenta está aprobada.
//
// Para cambiar quién es el administrador, actualiza el correo en
// ADMIN_EMAIL abajo y vuelve a publicar estas reglas (Firebase Console →
// Firestore Database → Reglas, o `firebase deploy --only firestore:rules`).

service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'nesdian2204@gmail.com';
    }

    function esPropio(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function estaAprobado(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.estado == 'aprobado';
    }

    // El perfil de riesgo de una persona: los cuatro campos, ni uno más ni uno
    // menos, cada uno dentro de sus límites. ⚠️ Los números son los de
    // `LIMITES` en `src/lib/perfilRiesgo.js`: si cambian allí, cambian aquí y
    // hay que volver a publicar estas reglas.
    function perfilRiesgoValido(p) {
      return p is map
        && p.keys().hasOnly(['capital', 'riesgoPct', 'limiteDiarioPct', 'maxPerdidasSeguidas'])
        && p.keys().hasAll(['capital', 'riesgoPct', 'limiteDiarioPct', 'maxPerdidasSeguidas'])
        && p.capital is number && p.capital >= 1 && p.capital <= 10000000
        && p.riesgoPct is number && p.riesgoPct >= 0.1 && p.riesgoPct <= 10
        && p.limiteDiarioPct is number && p.limiteDiarioPct >= 0.5 && p.limiteDiarioPct <= 20
        && p.maxPerdidasSeguidas is int && p.maxPerdidasSeguidas >= 1 && p.maxPerdidasSeguidas <= 20;
    }

    match /users/{uid} {
      allow get: if esPropio(uid) || esAdmin();
      allow list: if esAdmin();

      allow create: if esPropio(uid)
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.email == request.auth.token.email;

      // ⚠️ UN USUARIO NORMAL SOLO PUEDE CAMBIAR SU NOMBRE. NADA MÁS.
      //
      // Antes la regla decía «puede cambiar lo que quiera mientras no toque
      // `estado` ni `email`». Mientras la ficha solo guardaba el nombre eso
      // era inofensivo. Dejó de serlo el día que apareció `venceEl`: con la
      // regla vieja, cualquier miembro aprobado podía escribir su propia
      // fecha de vencimiento en el año 2099 —sin pasar por la app, hablando
      // con Firestore directamente— y no volver a pagar nunca. Y la
      // configuración de Firebase es pública, porque los dos repositorios lo
      // son.
      //
      // Se escribe con una LISTA DE LO PERMITIDO y no de lo prohibido, a
      // propósito: así el campo que se invente mañana nace protegido. Es la
      // misma forma de escribir que `esSombra` (una regla nueva nace apagada)
      // y por la misma razón — olvidarse de proteger algo cuesta caro,
      // olvidarse de permitir algo solo cuesta un aviso.
      //
      // Hoy ninguna de las dos apps escribe en su propia ficha: se comprobó
      // buscando en `src/` de las dos antes de apretar la regla.
      //
      // ⚠️ AMPLIADA EL 2026-10-31 con `seguimiento` y `avisos`, que son los
      // pares que la persona elige seguir y los avisos que se programa. Los
      // escribe `src/lib/useAvisos.js` y los LEE el programa que manda los
      // avisos al celular, que corre en un servidor — por eso van aquí y no
      // en el navegador.
      //
      // Se añaden SOLO esos dos y nada más: la lista sigue siendo blanca, así
      // que `estado`, `email` y `venceEl` siguen fuera del alcance de la
      // persona. Esto último no es teórico: antes de apretar esta regla
      // cualquiera podía regalarse una fecha de vencimiento desde la consola
      // del navegador.
      //
      // ⚠️ Y CON UN TOPE DE TAMAÑO, que es lo que una regla puede comprobar y
      // la app no. La app limita a 20 avisos, pero la app es código que corre
      // en el teléfono de la persona y se puede saltar; esto no. Sin el tope,
      // alguien podría escribirse una lista enorme y el programa que los lee
      // tendría que recorrerla entera en cada vuelta. Los números son los
      // mismos que `MAX_AVISOS` y `MAX_SEGUIMIENTO` — si allí cambian, aquí
      // también, y hay que volver a publicar las reglas.
      //
      // ⚠️ AMPLIADA EL 2026-11-12 con `perfilRiesgo`: el capital, el riesgo
      // por operación y los dos frenos de cada persona (fase 1 del plan del
      // Analizador). Lo escribe `src/lib/usePerfilRiesgo.js`. Se comprueba
      // ENTERO aquí —los cuatro campos, ni uno más, y cada uno dentro de sus
      // límites— porque la app los comprueba también, pero la app se puede
      // saltar. Los límites son los de `LIMITES` en `src/lib/perfilRiesgo.js`
      // y `prueba-perfil.mjs` falla si los dos se separan.
      //
      // ⚠️ AMPLIADA EL 2026-11-13 con `plantillas`: las combinaciones de
      // herramientas que cada persona guarda en el Analizador (fase 3). Lo
      // escribe `src/lib/usePlantillas.js`. Aquí solo se comprueba que sea una
      // lista de 10 como mucho —el `MAX_PLANTILLAS` de `analizador.js`—; lo de
      // dentro lo limpia la app al leer, así que una plantilla rara no rompe
      // nada, y lo que de verdad importa (que nadie se escriba una lista
      // enorme) sí lo puede comprobar una regla.
      //
      // ⚠️ AMPLIADA EL 2026-11-15 con `avisosExp_swing` y `avisosExp_intradia`:
      // qué experimentos le suenan a cada miembro en el celular (cada app guarda
      // en su campo, porque las dos comparten esta colección). Lo escribe
      // `src/components/AvisosExperimentos.jsx`. Solo se comprueba que sea una
      // lista de 10 como mucho: lo de dentro lo limpia `clavesElegidas` al leer,
      // y una clave rara simplemente no suena.
      allow update: if esAdmin()
        || (esPropio(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nombre', 'seguimiento', 'avisos', 'perfilRiesgo', 'plantillas',
                          'avisosExp_swing', 'avisosExp_intradia', 'avisosInt', 'diasTablero', 'estilo',
                          'curso'])
            && (!('perfilRiesgo' in request.resource.data)
                || perfilRiesgoValido(request.resource.data.perfilRiesgo))
            && (!('avisos' in request.resource.data)
                || (request.resource.data.avisos is list
                    && request.resource.data.avisos.size() <= 20))
            && (!('seguimiento' in request.resource.data)
                || (request.resource.data.seguimiento is list
                    && request.resource.data.seguimiento.size() <= 40))
            && (!('plantillas' in request.resource.data)
                || (request.resource.data.plantillas is list
                    && request.resource.data.plantillas.size() <= 10))
            // ⚠️ AMPLIADA EL 2026-11-17 con `diasTablero`: los días en que la
            // persona abrió el tablero completo, para la insignia «Analista
            // constante» (`src/lib/constancia.js`). Una lista de 14 como mucho.
            // ⚠️ AMPLIADA EL 2026-11-17 con `estilo`: cómo opera la persona
            // (`src/lib/estilo.js`). Solo una de las cuatro palabras.
            && (!('estilo' in request.resource.data)
                || request.resource.data.estilo in ['tendencias', 'rangos', 'noticias', 'nose'])
            // ⚠️ AMPLIADA EL 2026-11-18 con `curso`: las lecciones del curso
            // terminadas (`src/lib/curso.js`, `MAX_HECHAS`). Una lista de 100
            // como mucho; lo de dentro lo limpia `leerHechas` al leer.
            && (!('curso' in request.resource.data)
                || (request.resource.data.curso is list
                    && request.resource.data.curso.size() <= 100))
            && (!('diasTablero' in request.resource.data)
                || (request.resource.data.diasTablero is list
                    && request.resource.data.diasTablero.size() <= 14))
            && (!('avisosExp_swing' in request.resource.data)
                || (request.resource.data.avisosExp_swing is list
                    && request.resource.data.avisosExp_swing.size() <= 10))
            && (!('avisosExp_intradia' in request.resource.data)
                || (request.resource.data.avisosExp_intradia is list
                    && request.resource.data.avisosExp_intradia.size() <= 10))
            // ⚠️ AMPLIADA EL 2026-11-16 con `avisosInt`: los avisos inteligentes
            // que cada persona enciende (`src/lib/avisosInteligentes.js`). Una
            // lista de 3 como mucho. Las marcas de «ya avisado» (`intelEnviados`)
            // NO están aquí a propósito: las escribe solo el programa que manda
            // los avisos, con su cuenta de servicio.
            && (!('avisosInt' in request.resource.data)
                || (request.resource.data.avisosInt is list
                    && request.resource.data.avisosInt.size() <= 3)));

      allow delete: if esAdmin();

      match /trades/{tradeId} {
        allow read, write: if esPropio(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.estado == 'aprobado';
      }

      match /trades_intradia/{tradeId} {
        allow read, write: if esPropio(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.estado == 'aprobado';
      }

      // El MODO PRÁCTICA (2026-11-16): operaciones sin dinero que la app sigue
      // sola. Una sola colección para las dos apps; cada ficha lleva su `app`.
      //
      // ⚠️⚠️ EL RESULTADO LO ESCRIBE SOLO EL PROGRAMA (`resolver-practica.mjs`,
      // con la cuenta de servicio, que no pasa por estas reglas). Desde el
      // teléfono NO hay `update`, y al crear no se puede traer `estado` ni `r`:
      // si se pudiera, cualquiera se escribiría las ganadas a mano.
      //
      // ⚠️ Y solo se puede BORRAR una abierta (sin `estado`). Borrar las
      // perdidas ya resueltas dejaría un acierto inventado.
      //
      // ⚠️ `creado` tiene que ser la hora del SERVIDOR: con la del teléfono
      // alguien podría adelantarla y practicar con un precio viejo. Los campos
      // salen de `CAMPOS_CREAR` en `src/lib/practica.js`, y
      // `prueba-practica.mjs` falla si esta lista y aquélla se separan.
      match /practica/{opId} {
        allow read: if esPropio(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.estado == 'aprobado';

        allow delete: if esPropio(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.estado == 'aprobado'
          && !('estado' in resource.data);

        allow create: if esPropio(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.estado == 'aprobado'
          && request.resource.data.keys().hasAll(['app', 'par', 'lado', 'entrada', 'sl', 'tp', 'vela', 'metodo', 'creado'])
          && request.resource.data.keys().hasOnly(['app', 'par', 'lado', 'entrada', 'sl', 'tp', 'vela', 'metodo', 'creado', 'nota', 'riesgoUsd', 'lote', 'fuente', 'spread', 'spreadEl', 'swap', 'swap3', 'marcas'])
          && request.resource.data.app in ['swing', 'intradia']
          && request.resource.data.lado in ['COMPRA', 'VENTA']
          && request.resource.data.par is string && request.resource.data.par.size() <= 10
          && request.resource.data.entrada is number
          && request.resource.data.sl is number
          && request.resource.data.tp is number
          && request.resource.data.vela is string && request.resource.data.vela.size() <= 25
          && request.resource.data.metodo is string && request.resource.data.metodo.size() <= 20
          && request.resource.data.creado == request.time
          && (!('nota' in request.resource.data)
              || (request.resource.data.nota is string && request.resource.data.nota.size() <= 300))
          && (!('riesgoUsd' in request.resource.data)
              || (request.resource.data.riesgoUsd is number && request.resource.data.riesgoUsd > 0 && request.resource.data.riesgoUsd <= 1000000))
          && (!('lote' in request.resource.data)
              || (request.resource.data.lote is number && request.resource.data.lote > 0 && request.resource.data.lote <= 1000))
          // Lo que cuesta operar de verdad (2026-11-17): de dónde salió la
          // entrada, el spread y el swap de la cuenta real del desarrollador.
          // Topes iguales a SPREAD_MAX y SWAP_MAX de `src/lib/practica.js`.
          && (!('fuente' in request.resource.data) || request.resource.data.fuente in ['mt5', 'twelve'])
          && (!('spread' in request.resource.data)
              || (request.resource.data.spread is number && request.resource.data.spread >= 0 && request.resource.data.spread <= 50))
          && (!('spreadEl' in request.resource.data)
              || (request.resource.data.spreadEl is string && request.resource.data.spreadEl.size() <= 40))
          && (!('swap' in request.resource.data)
              || (request.resource.data.swap is number && request.resource.data.swap >= -50 && request.resource.data.swap <= 50))
          && (!('swap3' in request.resource.data)
              || (request.resource.data.swap3 is int && request.resource.data.swap3 >= 0 && request.resource.data.swap3 <= 6))
          // Lo que la persona programó en el Analizador, para dibujarlo en la
          // gráfica. Una lista corta (MARCAS_MAX); lo de dentro lo limpia la app
          // al leerlo, y solo lo ve su dueño.
          && (!('marcas' in request.resource.data)
              || (request.resource.data.marcas is list && request.resource.data.marcas.size() <= 40));
      }
    }

    // Suscripciones a los avisos push del celular. Hoy las usa solo la app
    // hermana de intradía (su vigía es el que manda los avisos), pero las
    // reglas son una sola para todo el proyecto de Firebase, así que viven
    // aquí, que es donde está la copia buena de este archivo.
    //
    // Una por APARATO, no por persona: alguien puede tener los avisos
    // activos en el celular y en el computador a la vez. Por eso es una
    // colección plana y cada documento lleva el `uid` de su dueño, en vez
    // de colgar de users/{uid} como el diario.
    //
    // Desde la app nadie las lista: quien las lee todas es el vigía, con
    // una cuenta de servicio que no pasa por estas reglas. Por eso no hay
    // `list`.
    // EL PRECIO AL SEGUNDO (2026-11-17). Lo escribe el puente de MT5 del
    // computador de Néstor cada segundo, y lo leen las apps.
    //
    // · ESCRIBE SOLO LA CUENTA DEL PUENTE, una cuenta de usuario propia que no
    //   es la de Néstor ni la cuenta de servicio (esa es la llave maestra de
    //   Firebase y no puede vivir en un PC de casa). Su contraseña está solo
    //   en ese computador, en `puente-mt5/firebase_puente.txt`, que no se sube.
    //   El correo puede estar aquí a la vista: sin la contraseña no sirve.
    // · LA FORMA SE COMPRUEBA: los dos campos y nada más, y como mucho 30
    //   pares. Así nadie puede usar este documento para guardar otra cosa.
    // · LEE CUALQUIERA CON SESIÓN, sin mirar si está aprobado. Mirarlo pediría
    //   un `get()` de su ficha en cada lectura, y cada cambio del precio es una
    //   lectura: se pagaría dos veces cada segundo. Es un precio de mercado,
    //   no un dato de nadie, y la app solo escucha con la cuenta aprobada.
    match /vivo/precios {
      allow get: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == 'puente-mt5@nestor-forex.firebaseapp.com'
        && request.resource.data.keys().hasOnly(['actualizadoEl', 'pares'])
        && request.resource.data.actualizadoEl is string
        && request.resource.data.pares is map
        && request.resource.data.pares.size() <= 30;
    }

    match /pushSubs/{subId} {
      allow get: if esPropio(resource.data.uid);

      allow create: if esPropio(request.resource.data.uid)
        && estaAprobado(request.auth.uid);

      // El identificador del documento sale de la dirección de envío, así
      // que reactivar los avisos en el mismo aparato sobrescribe en vez de
      // duplicar. Se exige ser dueño del documento que ya está Y del que
      // queda, para que nadie pueda apropiarse de la suscripción de otro.
      allow update: if esPropio(resource.data.uid)
        && esPropio(request.resource.data.uid)
        && estaAprobado(request.auth.uid);

      // Apagar los avisos no pide estar aprobado: a quien le retiraron la
      // cuenta hay que dejarlo dejar de recibirlos.
      allow delete: if esPropio(resource.data.uid);
    }
  }
}
