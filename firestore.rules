rules_version = '2';

// Reglas de seguridad de Firestore compartidas por Nestor Forex y su app
// hermana Nestor Forex Intradía (nestor-forex-intradia) — mismo proyecto de
// Firebase, mismas cuentas de usuarios/administrador, pero cada app guarda
// su diario de operaciones en su propia colección para no mezclar
// estadísticas de swing con las de intradía.
//
// Cómo funciona el acceso:
// - Cada persona solo puede leer y crear SU PROPIO documento en `users`.
// - Solo el administrador (identificado por su correo, más abajo) puede
//   leer la lista completa de usuarios, aprobar o retirar a alguien.
// - Nadie puede aprobarse a sí mismo: al crear su solicitud, el estado
//   queda forzado a 'pendiente', y un usuario normal no puede cambiar su
//   propio campo `estado`.
// - Las operaciones del diario de swing (`trades`, esta app) y las de
//   intradía (`trades_intradia`, la app hermana) de cada usuario solo son
//   visibles para ese mismo usuario, y solo si su cuenta está aprobada.
//
// Para cambiar quién es el administrador, actualiza el correo en
// ADMIN_EMAIL abajo y vuelve a publicar estas reglas (Firebase Console →
// Firestore Database → Reglas, o `firebase deploy --only firestore:rules`).

service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'nesdian2204@gmail.com';
    }

    function esPropio(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function estaAprobado(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.estado == 'aprobado';
    }

    match /users/{uid} {
      allow get: if esPropio(uid) || esAdmin();
      allow list: if esAdmin();

      allow create: if esPropio(uid)
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.email == request.auth.token.email;

      // ⚠️ UN USUARIO NORMAL SOLO PUEDE CAMBIAR SU NOMBRE. NADA MÁS.
      //
      // Antes la regla decía «puede cambiar lo que quiera mientras no toque
      // `estado` ni `email`». Mientras la ficha solo guardaba el nombre eso
      // era inofensivo. Dejó de serlo el día que apareció `venceEl`: con la
      // regla vieja, cualquier miembro aprobado podía escribir su propia
      // fecha de vencimiento en el año 2099 —sin pasar por la app, hablando
      // con Firestore directamente— y no volver a pagar nunca. Y la
      // configuración de Firebase es pública, porque los dos repositorios lo
      // son.
      //
      // Se escribe con una LISTA DE LO PERMITIDO y no de lo prohibido, a
      // propósito: así el campo que se invente mañana nace protegido. Es la
      // misma forma de escribir que `esSombra` (una regla nueva nace apagada)
      // y por la misma razón — olvidarse de proteger algo cuesta caro,
      // olvidarse de permitir algo solo cuesta un aviso.
      //
      // Hoy ninguna de las dos apps escribe en su propia ficha: se comprobó
      // buscando en `src/` de las dos antes de apretar la regla.
      allow update: if esAdmin()
        || (esPropio(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']));

      allow delete: if esAdmin();

      match /trades/{tradeId} {
        allow read, write: if esPropio(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.estado == 'aprobado';
      }

      match /trades_intradia/{tradeId} {
        allow read, write: if esPropio(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.estado == 'aprobado';
      }
    }

    // Suscripciones a los avisos push del celular. Hoy las usa solo la app
    // hermana de intradía (su vigía es el que manda los avisos), pero las
    // reglas son una sola para todo el proyecto de Firebase, así que viven
    // aquí, que es donde está la copia buena de este archivo.
    //
    // Una por APARATO, no por persona: alguien puede tener los avisos
    // activos en el celular y en el computador a la vez. Por eso es una
    // colección plana y cada documento lleva el `uid` de su dueño, en vez
    // de colgar de users/{uid} como el diario.
    //
    // Desde la app nadie las lista: quien las lee todas es el vigía, con
    // una cuenta de servicio que no pasa por estas reglas. Por eso no hay
    // `list`.
    match /pushSubs/{subId} {
      allow get: if esPropio(resource.data.uid);

      allow create: if esPropio(request.resource.data.uid)
        && estaAprobado(request.auth.uid);

      // El identificador del documento sale de la dirección de envío, así
      // que reactivar los avisos en el mismo aparato sobrescribe en vez de
      // duplicar. Se exige ser dueño del documento que ya está Y del que
      // queda, para que nadie pueda apropiarse de la suscripción de otro.
      allow update: if esPropio(resource.data.uid)
        && esPropio(request.resource.data.uid)
        && estaAprobado(request.auth.uid);

      // Apagar los avisos no pide estar aprobado: a quien le retiraron la
      // cuenta hay que dejarlo dejar de recibirlos.
      allow delete: if esPropio(resource.data.uid);
    }
  }
}
