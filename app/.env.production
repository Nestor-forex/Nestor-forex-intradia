# Configuración real de Firebase para la app publicada.
#
# Estos valores NO son secretos: Firebase los documenta como seguros para
# incluir en el código de una app web (a diferencia de una clave de API de
# servidor). La seguridad de verdad la dan las reglas de Firestore
# (firestore.rules) y Firebase Auth, no ocultar este archivo.
# https://firebase.google.com/docs/projects/api-keys

VITE_FIREBASE_API_KEY=AIzaSyBbIOnRPd8mmmBsmitm1orl6WXsdZfPgE8
VITE_FIREBASE_AUTH_DOMAIN=nestor-forex.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nestor-forex
VITE_FIREBASE_STORAGE_BUCKET=nestor-forex.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=680680525180
VITE_FIREBASE_APP_ID=1:680680525180:web:aace65c12e7497fa7628f9

VITE_ADMIN_EMAIL=nesdian2204@gmail.com

# Llave gratuita de Twelve Data (twelvedata.com) para los precios en vivo del
# barrido intradía. A diferencia de la config de Firebase de arriba, esta SÍ
# es una llave con cuota — publicarla en este repo público significa que en
# teoría alguien podría copiarla y gastar la cuota gratis del día (poco
# probable para un app tan chica, pero es honesto dejarlo dicho). Si eso pasa
# alguna vez, se reemplaza por una llave nueva gratis en twelvedata.com.
#
VITE_TWELVEDATA_KEY=0fe9bbe7681940aca7d90725fc5cb153

# Cuenta DEMO gratuita de Capital.com usada para el precio en vivo que
# complementa a Twelve Data (ver useCapitalLive.js). Es una cuenta demo con
# saldo simulado ($1,000 ficticios, sin dinero real ni forma de retirarlo),
# así que publicar estas credenciales aquí no pone dinero en riesgo — el
# peor caso es que alguien más use la sesión gratuita de la cuenta demo, y
# se resuelve borrando esta llave y generando una nueva en Capital.com
# (Configuración → Integraciones de API). Mismo criterio que la llave de
# Twelve Data de arriba. La llave quedó con permiso "Leer y operar" (no solo
# lectura) — sin impacto real por ser cuenta demo, pero si se genera una
# nueva llave más adelante, mejor elegir el permiso de solo lectura si
# Capital.com lo ofrece.
VITE_CAPITAL_API_KEY=BEJr8Y3aNS5NnZPs
VITE_CAPITAL_IDENTIFIER=nesdian2204@gmail.com
