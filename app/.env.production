# Configuración real de Firebase para la app publicada.
#
# Estos valores NO son secretos: Firebase los documenta como seguros para
# incluir en el código de una app web (a diferencia de una clave de API de
# servidor). La seguridad de verdad la dan las reglas de Firestore
# (firestore.rules) y Firebase Auth, no ocultar este archivo.
# https://firebase.google.com/docs/projects/api-keys

VITE_FIREBASE_API_KEY=AIzaSyBbIOnRPd8mmmBsmitm1orl6WXsdZfPgE8
VITE_FIREBASE_AUTH_DOMAIN=nestor-forex.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nestor-forex
VITE_FIREBASE_STORAGE_BUCKET=nestor-forex.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=680680525180
VITE_FIREBASE_APP_ID=1:680680525180:web:aace65c12e7497fa7628f9

VITE_ADMIN_EMAIL=nesdian2204@gmail.com

# Llave gratuita de Twelve Data (twelvedata.com) para los precios en vivo del
# barrido intradía. A diferencia de la config de Firebase de arriba, esta SÍ
