# Copia este archivo a ".env.local" (que nunca se sube al repositorio) para
# probar Firebase en tu computador con `npm run dev`.
#
# Los valores exactos salen de: Firebase Console → ⚙️ Configuración del
# proyecto → General → "Tus apps" → app web → "Configuración del SDK".
#
# La app publicada (GitHub Pages) usa los valores reales ya guardados en
# ".env.production" (sí se sube al repositorio: son de un app web de
# Firebase, no son secretos — ver el comentario en ese archivo).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Correo que tendrá permisos de administrador (aprobar/retirar miembros).
VITE_ADMIN_EMAIL=nesdian2204@gmail.com

# ⚠️ LA LLAVE DE TWELVE DATA YA NO VA AQUÍ.
#
# La app no le pide los precios a Twelve Data: lee el barrido ya calculado que
# publica GitHub. Si la llave estuviera en este archivo, Vite la metería dentro
# del JavaScript que descarga cualquiera que abra la página.
#
# Vive en el secreto `TWELVEDATA_KEY` del repositorio, que solo ven los
# workflows. Si montas esto en otro repositorio, créalo ahí igual (Settings →
# Secrets and variables → Actions → New repository secret).
#
# Para probar en tu propio computador puedes exportarla en la terminal:
#     export TWELVEDATA_KEY=tu-llave
# o escribirla en tu `.env.local`, que no se sube al repositorio.

# (Las credenciales de capital.com que había aquí se quitaron el 2026-09-02:
# viajaban dentro de la app y daban permiso de leer Y OPERAR. La capa de precio
# al segundo que las usaba ya no existe — ver el comentario de useMarketData.js.)
